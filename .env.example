# Public site URL used for sitemap, robots, and Open Graph absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (disabled when unset)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Show dashboard skeleton for ~1.2s (QA for loading states)
# NEXT_PUBLIC_SLOW_DASHBOARD=1

# Optional agent LLM tool-picker (off by default; rules always execute tools locally)
# NEXT_PUBLIC_AGENT_LLM=1
# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-4o-mini

# --- Supabase ---
# Local dev: run `npm run db:start`, then copy the values it prints (API URL, publishable key, secret key).
# Hosted: see docs/PUBLISH-CHECKLIST.md. Put real values in .env.local / host settings only; never commit them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by /api/leads, /api/demo/reset and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
